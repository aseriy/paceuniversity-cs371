#!ipxe

dhcp

set ubuntu https://releases.ubuntu.com/24.04.5
set seed https://raw.githubusercontent.com/aseriy/paceuniversity-cs371/main/provisioning/autoinstall/
set semicolon:hex 3b

kernel ${ubuntu}/netboot/amd64/linux initrd=initrd \
  root=/dev/ram0 ramdisk_size=1500000 \
  cloud-config-url=/dev/null ip=dhcp \
  url=${ubuntu}/ubuntu-24.04.5-live-server-amd64.iso \
  autoinstall ds=nocloud-net${semicolon:string}s=${seed}

initrd ${ubuntu}/netboot/amd64/initrd
boot
