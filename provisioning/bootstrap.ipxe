#!ipxe

dhcp

set site https://aseriy.github.io/paceuniversity-cs371/provisioning

kernel ${site}/ubuntu/vmlinuz initrd=initrd ip=dhcp \
  url=https://releases.ubuntu.com/24.04/ubuntu-24.04-live-server-amd64.iso \
  autoinstall ds=nocloud-net;s=${site}/autoinstall/

initrd ${site}/ubuntu/initrd
boot
